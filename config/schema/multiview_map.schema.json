{
  "$defs": {
    "SourceId": {
      "description": "Everything that can be routed in the ATEM: cameras, the laptop and SuperSource.\n``OTHER`` is anything else the technician put on air (black, bars, a colour, a media player\nwith a logo): CutCut leaves it alone until a known source is back (P10).",
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "LAPTOP",
        "C7",
        "SUPERSOURCE",
        "OTHER"
      ],
      "title": "SourceId",
      "type": "string"
    },
    "Tile": {
      "additionalProperties": false,
      "properties": {
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^(PVW|PGM|W[1-8])$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "rect": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rect",
          "type": "array"
        },
        "source": {
          "pattern": "^(preview|program|input[1-8]|mediaplayer[12]|supersource|recording_status|streaming_status|audio_meters|black|colorbars|other)$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rect",
        "source"
      ],
      "title": "Tile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "layout": {
      "default": "2+8, preview venstre",
      "title": "Layout",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "default": "",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "title": "Status",
      "type": "string"
    },
    "switcher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Switcher"
    },
    "tiles": {
      "items": {
        "$ref": "#/$defs/Tile"
      },
      "title": "Tiles",
      "type": "array"
    }
  },
  "required": [
    "tiles"
  ],
  "title": "MultiviewMap",
  "type": "object"
}
