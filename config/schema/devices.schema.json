{
  "$defs": {
    "AlertsConfig": {
      "additionalProperties": false,
      "description": "Alerts outside the studio (HS-3, Q29): email when something is red for over a minute,\nand at once when a recording fails.",
      "properties": {
        "email": {
          "items": {
            "type": "string"
          },
          "title": "Email",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_per_hour": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Per Hour",
          "type": "integer"
        },
        "red_after_s": {
          "default": 60.0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Red After S",
          "type": "number"
        },
        "smtp": {
          "$ref": "#/$defs/SmtpConfig",
          "default": {
            "host": "",
            "port": 587,
            "sender": "cutcut-studio@example.org",
            "starttls": true,
            "username": ""
          }
        }
      },
      "title": "AlertsConfig",
      "type": "object"
    },
    "AtemDevice": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "format": "ipv4",
          "title": "Ip",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "ip"
      ],
      "title": "AtemDevice",
      "type": "object"
    },
    "AudioDevice": {
      "additionalProperties": false,
      "description": "The RØDECaster's multitrack over USB (docs/research/lyd-fra-rodecaster.md, AU-5).",
      "properties": {
        "backend": {
          "default": "asio",
          "enum": [
            "asio",
            "wasapi"
          ],
          "title": "Backend",
          "type": "string"
        },
        "buffer": {
          "default": 256,
          "maximum": 2048,
          "minimum": 64,
          "title": "Buffer",
          "type": "integer"
        },
        "channels": {
          "default": 20,
          "maximum": 32,
          "minimum": 12,
          "title": "Channels",
          "type": "integer"
        },
        "device": {
          "default": "RODECaster",
          "title": "Device",
          "type": "string"
        }
      },
      "title": "AudioDevice",
      "type": "object"
    },
    "CameraDevice": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        },
        "limits": {
          "$ref": "#/$defs/CameraLimits",
          "default": {
            "max_speed": 0.5,
            "pan": [
              -170.0,
              170.0
            ],
            "slow_zoom_speed": 0.02,
            "tilt": [
              -30.0,
              90.0
            ],
            "zoom": [
              0.0,
              1.0
            ]
          }
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "CameraDevice",
      "type": "object"
    },
    "CameraId": {
      "description": "Camera IDs. C1–C4 close-ups (ATEM inputs 1–4), C5 bird's-eye, C7 optional wide.",
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C7"
      ],
      "title": "CameraId",
      "type": "string"
    },
    "CameraLimits": {
      "additionalProperties": false,
      "description": "How far CutCut may move a camera (CA-1, 8.4). Commands outside are clamped and logged.\n\nPan and tilt in degrees from the camera's home, zoom 0 (widest) to 1 (tightest), speed\n0–1 of the camera's top speed.",
      "properties": {
        "max_speed": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Speed",
          "type": "number"
        },
        "pan": {
          "default": [
            -170.0,
            170.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Pan",
          "type": "array"
        },
        "slow_zoom_speed": {
          "default": 0.02,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Slow Zoom Speed",
          "type": "number"
        },
        "tilt": {
          "default": [
            -30.0,
            90.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Tilt",
          "type": "array"
        },
        "zoom": {
          "default": [
            0.0,
            1.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Zoom",
          "type": "array"
        }
      },
      "title": "CameraLimits",
      "type": "object"
    },
    "CardApi": {
      "additionalProperties": false,
      "description": "The lookup from card number to user (SE-5, M4). Address and key come from the IT\ndepartment and are set on the PC; none until the card login is switched on (D-057).",
      "properties": {
        "timeout_s": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "CardApi",
      "type": "object"
    },
    "CardReaderDevice": {
      "additionalProperties": false,
      "properties": {
        "usb_id": {
          "default": "09D8:0320",
          "pattern": "^[0-9A-F]{4}:[0-9A-F]{4}$",
          "title": "Usb Id",
          "type": "string"
        }
      },
      "title": "CardReaderDevice",
      "type": "object"
    },
    "CompanionDevice": {
      "additionalProperties": false,
      "properties": {
        "engine_page": {
          "default": 10,
          "maximum": 99,
          "minimum": 1,
          "title": "Engine Page",
          "type": "integer"
        },
        "operator_page": {
          "default": 11,
          "maximum": 99,
          "minimum": 1,
          "title": "Operator Page",
          "type": "integer"
        },
        "pages_version": {
          "default": 1,
          "minimum": 1,
          "title": "Pages Version",
          "type": "integer"
        },
        "url": {
          "default": "http://127.0.0.1:8000/",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "title": "CompanionDevice",
      "type": "object"
    },
    "PearlDevice": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "format": "ipv4",
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "recorder_id": {
          "default": "1",
          "title": "Recorder Id",
          "type": "string"
        },
        "scheme": {
          "default": "https",
          "enum": [
            "https",
            "http"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "username": {
          "default": "cutcut",
          "title": "Username",
          "type": "string"
        },
        "verify_tls": {
          "default": false,
          "title": "Verify Tls",
          "type": "boolean"
        }
      },
      "required": [
        "ip"
      ],
      "title": "PearlDevice",
      "type": "object"
    },
    "SmtpConfig": {
      "additionalProperties": false,
      "description": "The mail relay the studio PC sends alerts through (HS-3). Empty host: no email.",
      "properties": {
        "host": {
          "default": "",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 587,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "sender": {
          "default": "cutcut-studio@example.org",
          "title": "Sender",
          "type": "string"
        },
        "starttls": {
          "default": true,
          "title": "Starttls",
          "type": "boolean"
        },
        "username": {
          "default": "",
          "title": "Username",
          "type": "string"
        }
      },
      "title": "SmtpConfig",
      "type": "object"
    },
    "SupportConfig": {
      "additionalProperties": false,
      "description": "Who the user contacts when something is wrong (D-065). Shown on touch at «Hjelp» and\non the help screens. Set under Innstillinger → Varsling.",
      "properties": {
        "email": {
          "default": "magnus.lian@ntnu.no",
          "title": "Email",
          "type": "string"
        }
      },
      "title": "SupportConfig",
      "type": "object"
    },
    "VideoDevice": {
      "additionalProperties": false,
      "description": "Where the video layer takes the ATEM multiview from (D-071): the INOGENI 4KXUSB3 on the\nATEM's multiview output (D-068), or the ATEM's own webcam output over USB-C with Multi View\nchosen in ATEM Software Control. Both are UVC devices to Windows, found by part of their\nDirectShow name (``name``, or the method's usual name when empty). ``index`` is used when\nno name matches (or off Windows). ``none``: no video layer, CutCut cuts on sound alone.\n\n``delay_ms`` holds the measured delay from the ATEM to a frame per method (``hwtest\nvision`` V4), so both can be compared; for a method not measured yet the engine assumes\nits starting point.",
      "properties": {
        "delay_ms": {
          "additionalProperties": {
            "maximum": 1000,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "inogeni",
              "atem_usb"
            ]
          },
          "title": "Delay Ms",
          "type": "object"
        },
        "fps": {
          "default": 50,
          "maximum": 60,
          "minimum": 24,
          "title": "Fps",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "title": "Height",
          "type": "integer"
        },
        "index": {
          "default": 0,
          "maximum": 15,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "default": "uvc",
          "enum": [
            "uvc",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "default": "inogeni",
          "enum": [
            "inogeni",
            "atem_usb"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "width": {
          "default": 1920,
          "title": "Width",
          "type": "integer"
        }
      },
      "title": "VideoDevice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "$ref": "#/$defs/AlertsConfig",
      "default": {
        "email": [],
        "enabled": false,
        "max_per_hour": 10,
        "red_after_s": 60.0,
        "smtp": {
          "host": "",
          "port": 587,
          "sender": "cutcut-studio@example.org",
          "starttls": true,
          "username": ""
        }
      }
    },
    "api_port": {
      "default": 8080,
      "maximum": 65535,
      "minimum": 1024,
      "title": "Api Port",
      "type": "integer"
    },
    "atem": {
      "$ref": "#/$defs/AtemDevice"
    },
    "audio": {
      "$ref": "#/$defs/AudioDevice",
      "default": {
        "backend": "asio",
        "buffer": 256,
        "channels": 20,
        "device": "RODECaster"
      }
    },
    "cameras": {
      "additionalProperties": {
        "$ref": "#/$defs/CameraDevice"
      },
      "propertyNames": {
        "$ref": "#/$defs/CameraId"
      },
      "title": "Cameras",
      "type": "object"
    },
    "card_api": {
      "$ref": "#/$defs/CardApi",
      "default": {
        "timeout_s": 3.0,
        "url": null
      }
    },
    "card_reader": {
      "$ref": "#/$defs/CardReaderDevice",
      "default": {
        "usb_id": "09D8:0320"
      }
    },
    "companion": {
      "$ref": "#/$defs/CompanionDevice",
      "default": {
        "engine_page": 10,
        "operator_page": 11,
        "pages_version": 1,
        "url": "http://127.0.0.1:8000/"
      }
    },
    "pearl": {
      "$ref": "#/$defs/PearlDevice"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "studio": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Studio",
      "type": "string"
    },
    "support": {
      "$ref": "#/$defs/SupportConfig",
      "default": {
        "email": "magnus.lian@ntnu.no"
      }
    },
    "video": {
      "$ref": "#/$defs/VideoDevice",
      "default": {
        "delay_ms": {},
        "fps": 50,
        "height": 1080,
        "index": 0,
        "kind": "uvc",
        "method": "inogeni",
        "name": "",
        "width": 1920
      }
    }
  },
  "required": [
    "studio",
    "atem",
    "pearl",
    "cameras"
  ],
  "title": "Devices",
  "type": "object"
}
