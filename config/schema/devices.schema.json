{
  "$defs": {
    "AlertsConfig": {
      "additionalProperties": false,
      "description": "Alerts outside the studio (HS-3, Q29): email when something is red for over a minute,\nand at once when a recording fails.",
      "properties": {
        "email": {
          "items": {
            "type": "string"
          },
          "title": "Email",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_per_hour": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Per Hour",
          "type": "integer"
        },
        "red_after_s": {
          "default": 60.0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Red After S",
          "type": "number"
        },
        "smtp": {
          "$ref": "#/$defs/SmtpConfig",
          "default": {
            "host": "",
            "port": 587,
            "sender": "cutcut-studio@ntnu.no",
            "starttls": true,
            "username": ""
          }
        }
      },
      "title": "AlertsConfig",
      "type": "object"
    },
    "AtemDevice": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "format": "ipv4",
          "title": "Ip",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "ip"
      ],
      "title": "AtemDevice",
      "type": "object"
    },
    "AudioDevice": {
      "additionalProperties": false,
      "description": "The RØDECaster's multitrack over USB (docs/research/lyd-fra-rodecaster.md, AU-5).",
      "properties": {
        "backend": {
          "default": "asio",
          "enum": [
            "asio",
            "wasapi"
          ],
          "title": "Backend",
          "type": "string"
        },
        "buffer": {
          "default": 256,
          "maximum": 2048,
          "minimum": 64,
          "title": "Buffer",
          "type": "integer"
        },
        "channels": {
          "default": 20,
          "maximum": 32,
          "minimum": 12,
          "title": "Channels",
          "type": "integer"
        },
        "device": {
          "default": "RODECaster",
          "title": "Device",
          "type": "string"
        }
      },
      "title": "AudioDevice",
      "type": "object"
    },
    "CameraDevice": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        },
        "limits": {
          "$ref": "#/$defs/CameraLimits",
          "default": {
            "max_speed": 0.5,
            "pan": [
              -170.0,
              170.0
            ],
            "tilt": [
              -30.0,
              90.0
            ],
            "zoom": [
              0.0,
              1.0
            ]
          }
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "CameraDevice",
      "type": "object"
    },
    "CameraId": {
      "description": "Camera IDs. C1–C4 close-ups (ATEM inputs 1–4), C5 bird's-eye, C7 optional wide.",
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C7"
      ],
      "title": "CameraId",
      "type": "string"
    },
    "CameraLimits": {
      "additionalProperties": false,
      "description": "How far CutCut may move a camera (CA-1, 8.4). Commands outside are clamped and logged.\n\nPan and tilt in degrees from the camera's home, zoom 0 (widest) to 1 (tightest), speed\n0–1 of the camera's top speed.",
      "properties": {
        "max_speed": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Speed",
          "type": "number"
        },
        "pan": {
          "default": [
            -170.0,
            170.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Pan",
          "type": "array"
        },
        "tilt": {
          "default": [
            -30.0,
            90.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Tilt",
          "type": "array"
        },
        "zoom": {
          "default": [
            0.0,
            1.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Zoom",
          "type": "array"
        }
      },
      "title": "CameraLimits",
      "type": "object"
    },
    "CardReaderDevice": {
      "additionalProperties": false,
      "properties": {
        "usb_id": {
          "default": "09D8:0320",
          "pattern": "^[0-9A-F]{4}:[0-9A-F]{4}$",
          "title": "Usb Id",
          "type": "string"
        }
      },
      "title": "CardReaderDevice",
      "type": "object"
    },
    "CompanionDevice": {
      "additionalProperties": false,
      "properties": {
        "engine_page": {
          "default": 10,
          "maximum": 99,
          "minimum": 1,
          "title": "Engine Page",
          "type": "integer"
        },
        "operator_page": {
          "default": 11,
          "maximum": 99,
          "minimum": 1,
          "title": "Operator Page",
          "type": "integer"
        },
        "pages_version": {
          "default": 1,
          "minimum": 1,
          "title": "Pages Version",
          "type": "integer"
        },
        "url": {
          "default": "http://127.0.0.1:8000/",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "title": "CompanionDevice",
      "type": "object"
    },
    "NtnuApi": {
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Timeout S",
          "type": "number"
        },
        "url": {
          "default": "https://gw-ntnu.intark.uh-it.no/tia/v4/autorisasjon/mifareid",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "title": "NtnuApi",
      "type": "object"
    },
    "PearlDevice": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "format": "ipv4",
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "recorder_id": {
          "default": "1",
          "title": "Recorder Id",
          "type": "string"
        },
        "scheme": {
          "default": "https",
          "enum": [
            "https",
            "http"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "username": {
          "default": "cutcut",
          "title": "Username",
          "type": "string"
        },
        "verify_tls": {
          "default": false,
          "title": "Verify Tls",
          "type": "boolean"
        }
      },
      "required": [
        "ip"
      ],
      "title": "PearlDevice",
      "type": "object"
    },
    "SmtpConfig": {
      "additionalProperties": false,
      "description": "The mail relay the studio PC sends alerts through (HS-3). Empty host: no email.",
      "properties": {
        "host": {
          "default": "",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 587,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "sender": {
          "default": "cutcut-studio@ntnu.no",
          "title": "Sender",
          "type": "string"
        },
        "starttls": {
          "default": true,
          "title": "Starttls",
          "type": "boolean"
        },
        "username": {
          "default": "",
          "title": "Username",
          "type": "string"
        }
      },
      "title": "SmtpConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "$ref": "#/$defs/AlertsConfig",
      "default": {
        "email": [],
        "enabled": false,
        "max_per_hour": 10,
        "red_after_s": 60.0,
        "smtp": {
          "host": "",
          "port": 587,
          "sender": "cutcut-studio@ntnu.no",
          "starttls": true,
          "username": ""
        }
      }
    },
    "api_port": {
      "default": 8080,
      "maximum": 65535,
      "minimum": 1024,
      "title": "Api Port",
      "type": "integer"
    },
    "atem": {
      "$ref": "#/$defs/AtemDevice"
    },
    "audio": {
      "$ref": "#/$defs/AudioDevice",
      "default": {
        "backend": "asio",
        "buffer": 256,
        "channels": 20,
        "device": "RODECaster"
      }
    },
    "cameras": {
      "additionalProperties": {
        "$ref": "#/$defs/CameraDevice"
      },
      "propertyNames": {
        "$ref": "#/$defs/CameraId"
      },
      "title": "Cameras",
      "type": "object"
    },
    "card_reader": {
      "$ref": "#/$defs/CardReaderDevice",
      "default": {
        "usb_id": "09D8:0320"
      }
    },
    "companion": {
      "$ref": "#/$defs/CompanionDevice",
      "default": {
        "engine_page": 10,
        "operator_page": 11,
        "pages_version": 1,
        "url": "http://127.0.0.1:8000/"
      }
    },
    "ntnu_api": {
      "$ref": "#/$defs/NtnuApi",
      "default": {
        "timeout_s": 3.0,
        "url": "https://gw-ntnu.intark.uh-it.no/tia/v4/autorisasjon/mifareid"
      }
    },
    "pearl": {
      "$ref": "#/$defs/PearlDevice"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "studio": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Studio",
      "type": "string"
    }
  },
  "required": [
    "studio",
    "atem",
    "pearl",
    "cameras"
  ],
  "title": "Devices",
  "type": "object"
}
