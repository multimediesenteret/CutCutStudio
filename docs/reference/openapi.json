{
  "components": {
    "schemas": {
      "ContentIn": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "ContentIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginIn": {
        "additionalProperties": false,
        "properties": {
          "pin": {
            "maxLength": 12,
            "minLength": 4,
            "title": "Pin",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "pin"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "Ok": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "Ok",
        "type": "object"
      },
      "OnIn": {
        "additionalProperties": false,
        "properties": {
          "on": {
            "title": "On",
            "type": "boolean"
          }
        },
        "required": [
          "on"
        ],
        "title": "OnIn",
        "type": "object"
      },
      "PresetIn": {
        "additionalProperties": false,
        "properties": {
          "preset": {
            "enum": [
              "rolig",
              "standard",
              "energisk"
            ],
            "title": "Preset",
            "type": "string"
          }
        },
        "required": [
          "preset"
        ],
        "title": "PresetIn",
        "type": "object"
      },
      "RecordingIn": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "start",
              "stop"
            ],
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "RecordingIn",
        "type": "object"
      },
      "SessionIn": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "username": {
            "pattern": "^[a-z0-9._-]{1,64}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "SessionIn",
        "type": "object"
      },
      "ShotIn": {
        "additionalProperties": false,
        "properties": {
          "shot": {
            "title": "Shot",
            "type": "string"
          }
        },
        "required": [
          "shot"
        ],
        "title": "ShotIn",
        "type": "object"
      },
      "ShowIn": {
        "additionalProperties": false,
        "properties": {
          "guests": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Guests",
            "type": "integer"
          },
          "laptop": {
            "default": false,
            "title": "Laptop",
            "type": "boolean"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "video": {
            "default": true,
            "title": "Video",
            "type": "boolean"
          }
        },
        "required": [
          "guests"
        ],
        "title": "ShowIn",
        "type": "object"
      },
      "StepIn": {
        "additionalProperties": false,
        "properties": {
          "step": {
            "$ref": "#/components/schemas/TouchStep"
          }
        },
        "required": [
          "step"
        ],
        "title": "StepIn",
        "type": "object"
      },
      "TouchStep": {
        "description": "Touch flow (D-036): rest → ready → countdown → recording → done.",
        "enum": [
          "idle",
          "ready",
          "countdown",
          "rec",
          "done"
        ],
        "title": "TouchStep",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
